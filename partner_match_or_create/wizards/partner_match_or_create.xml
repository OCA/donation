<odoo>
    <record id="partner_match_or_create_form" model="ir.ui.view">
        <field name="model">partner.match.or.create</field>
        <field name="arch" type="xml">
            <form>
                <group name="main" col="4" string="">
                    <field name="res_model" invisible="1" />
                    <field name="res_id" invisible="1" />
                    <field name="firstname" />
                    <field name="lastname" />
                    <field name="phone" />
                    <field name="mobile" />
                    <field name="email" />
                    <field name="title_id" />
                </group>
                <group name="main-address">
                    <label for="street" string="Address" />
                    <div class="o_address_format">
                        <field name="street" class="o_address_street" />
                        <field name="street2" class="o_address_street" />
                        <field name="city" placeholder="City" class="o_address_city" />
                        <field
                            name="state_id"
                            class="o_address_state"
                            placeholder="State"
                            options="{'no_open': True, 'no_quick_create': True}"
                            context="{'default_country_id': country_id}"
                        />
                        <field name="zip" placeholder="ZIP" class="o_address_zip" />
                        <field
                            name="country_id"
                            placeholder="Country"
                            class="o_address_country"
                            options='{"no_open": True, "no_create": True}'
                        />
                    </div>
                </group>
                <group
                    string="Suggested Existing Contacts"
                    name="suggestions"
                    invisible="update_partner_id or not suggested_partner_ids"
                >
                    <field name="suggested_partner_ids" nolabel="1" colspan="2" />
                </group>
                <group name="choice">
                    <field
                        name="create_or_update"
                        widget="radio"
                        nolabel="1"
                        colspan="2"
                    />
                </group>
                <group invisible="create_or_update != 'update'" name="update">
                    <field
                        name="update_partner_id"
                        required="create_or_update == 'update'"
                    />
                </group>
                <group
                    invisible="create_or_update != 'update' or not update_partner_id"
                    name="update-infos"
                    col="4"
                    string=""
                >
                    <field name="update_partner_phone" />
                    <field name="update_partner_mobile" />
                    <field name="update_partner_email" />
                </group>
                <group
                    invisible="create_or_update != 'update' or not update_partner_id"
                    name="update-address"
                >
                    <label for="update_partner_street" string="Current Address" />

                    <div class="o_address_format">
                        <field name="update_partner_street" class="o_address_street" />
                        <field name="update_partner_street2" class="o_address_street" />
                        <field
                            name="update_partner_city"
                            placeholder="City"
                            class="o_address_city"
                        />
                        <field
                            name="update_partner_state_id"
                            placeholder="State"
                            class="o_address_state"
                        />
                        <field
                            name="update_partner_zip"
                            placeholder="ZIP"
                            class="o_address_zip"
                        />
                        <field
                            name="update_partner_country_id"
                            placeholder="Country"
                            class="o_address_country"
                            options='{"no_open": True, "no_create": True}'
                            required="create_or_update == 'update'"
                        />
                    </div>
                </group>
                <group
                    invisible="create_or_update != 'update' or not update_partner_id"
                    name="update-bools"
                    col="4"
                    string=""
                >
                    <field name="update_phone" />
                    <field name="update_mobile" />
                    <field name="update_email" />
                    <field name="update_address" />
                </group>
                <footer>
                    <button
                        name="create_partner"
                        type="object"
                        colspan="2"
                        class="btn-primary"
                        string="Create New Contact"
                        invisible="create_or_update != 'create'"
                    />
                    <button
                        name="update_partner"
                        type="object"
                        colspan="2"
                        class="btn-primary"
                        string="Update Existing Contact"
                        invisible="create_or_update != 'update'"
                    />
                    <button special="cancel" string="Cancel" class="btn-default" />
                </footer>
            </form>
        </field>
    </record>

    <record id="partner_match_or_create_action" model="ir.actions.act_window">
        <field name="name">Create or Update Contact</field>
        <field name="res_model">partner.match.or.create</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
