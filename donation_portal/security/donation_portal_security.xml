<odoo noupdate="1">
    <record id="donation_portal_donation_rule" model="ir.rule">
        <field name="name">Donation Portal: own validated donations</field>
        <field name="model_id" ref="donation.model_donation_donation" />
        <field name="groups" eval="[(4, ref('base.group_portal'))]" />
        <field
            name="domain_force"
        >[('state', '=', 'done'), ('partner_id', '=', user.partner_id.id)]</field>
    </record>
    <record id="donation_portal_donation_line_rule" model="ir.rule">
        <field name="name">Donation Line Portal: own validated donations</field>
        <field name="model_id" ref="donation.model_donation_line" />
        <field name="groups" eval="[(4, ref('base.group_portal'))]" />
        <field
            name="domain_force"
        >[('donation_id.state', '=', 'done'), ('donation_id.partner_id', '=', user.partner_id.id)]</field>
    </record>
</odoo>
